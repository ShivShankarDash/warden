{
  "name": "@shivdev/agent-warden",
  "version": "0.3.1",
  "bin": {
    "agent-warden": "./src/cli.ts",
    "warden": "./src/cli.ts"
  },
  "files": [
    "src/",
    "models/",
    "policies/",
    "dashboard/",
    "redteam/",
    "README.md",
    "DEVELOPER.md",
    "DEPLOY.md"
  ],
  "scripts": {
    "dev": "bun --hot src/api/index.ts",
    "eval": "bun eval/runner.ts",
    "test": "DB_PATH=./warden-test.db bun test",
    "eval:session": "bun eval/sessions.ts",
    "eval:similarity": "bun eval/similarity.ts",
    "test:clean": "rm -f warden-test.db && DB_PATH=./warden-test.db bun test",
    "eval:robustness": "bun eval/robustness.ts",
    "redteam": "bun redteam/runner.ts",
    "redteam:watch": "bun redteam/scheduler.ts",
    "selfplay": "bun redteam/selfplay.ts",
    "intel": "bun src/intel/agent.ts",
    "intel:watch": "bun src/intel/agent.ts --watch"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.5.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cheerio": "^1.0.0",
    "fflate": "^0.8.3",
    "mailparser": "^3.7.2",
    "mammoth": "^1.8.0",
    "remark": "^15.0.1",
    "remark-parse": "^11.0.0",
    "tesseract.js": "^5.1.1",
    "unpdf": "^0.12.0",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/mailparser": "^3.4.5",
    "pdf-lib": "^1.17.1"
  },
  "description": "A firewall for AI agents. Detects and blocks prompt injection in email, web pages, documents and MCP tool results before they reach your model.",
  "license": "MIT",
  "author": "shivdev",
  "homepage": "https://github.com/ShivShankarDash/warden#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShivShankarDash/warden.git"
  },
  "bugs": {
    "url": "https://github.com/ShivShankarDash/warden/issues"
  },
  "keywords": [
    "prompt-injection",
    "ai-security",
    "llm-security",
    "mcp",
    "model-context-protocol",
    "agent-security",
    "firewall",
    "guardrails",
    "jailbreak-detection"
  ],
  "engines": {
    "bun": ">=1.1.0"
  }
}
