    "mailparser": "^3.7.2",
    "mammoth": "^1.8.0",
    "remark": "^15.0.1",
    "remark-parse": "^11.0.0",
    "tesseract.js": "^5.1.1",
    "unpdf": "^0.12.0",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
