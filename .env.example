# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Required for the LLM judge stage (src/detect/judge.ts).
# Without it the judge is skipped and Warden runs rules + classifier only.
# OPENAI_API_KEY also works; set JUDGE_BASE_URL to match if not using OpenRouter.
OPENROUTER_API_KEY=

# Optional overrides
# JUDGE_MODEL=anthropic/claude-haiku-4.5
# JUDGE_BASE_URL=https://openrouter.ai/api/v1
# PROMPT_GUARD_MODEL=gravitee-io/Llama-Prompt-Guard-2-22M-onnx
# PORT=3000

# --- API Security ---
# Comma-separated list of valid API keys. When empty or unset, auth is
# disabled (local dev mode). Each key goes in the X-API-Key header.
WARDEN_API_KEYS=

# Single API key the MCP gateway sends to a remote Warden server.
# Only needed when the gateway talks to a Warden instance that has
# WARDEN_API_KEYS set.
# WARDEN_API_KEY=

# Rate limiting (applied to /scan, /scan-output, /check-tool, /ingest)
# WARDEN_RATE_LIMIT=20
# WARDEN_RATE_BURST=50
